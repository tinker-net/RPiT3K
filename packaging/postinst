#!/bin/sh
set -e
if [ "$1" = configure ]; then
 if ! getent passwd rpi-ton3k >/dev/null; then
  adduser --system --group --home /var/lib/rpi-ton3k --no-create-home rpi-ton3k
 fi
 install -d -m700 -o rpi-ton3k -g rpi-ton3k /var/lib/rpi-ton3k
 if [ ! -e /var/lib/rpi-ton3k/data ]; then
  stage=$(mktemp -d /var/lib/rpi-ton3k/.migration.XXXXXX)
  for f in library presets.json settings.json favorites.json appearance.json amp-art practice-tracks practice-scores trash; do
   if [ -e "/var/lib/rpi-ton3k/$f" ]; then cp -a "/var/lib/rpi-ton3k/$f" "$stage/"; fi
  done
  chown -R rpi-ton3k:rpi-ton3k "$stage"
  mv "$stage" /var/lib/rpi-ton3k/data
 fi
 tmp=$(mktemp)
 trap 'rm -f "$tmp"' EXIT
 printf '%s\n' 'rpi-ton3k ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block rpi-ton3k-update.service' > "$tmp"
 /usr/sbin/visudo -cf "$tmp"
 install -m0440 "$tmp" /etc/sudoers.d/rpi-ton3k
 if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
  if [ -n "${2:-}" ]; then
   if systemctl is-active --quiet rpi-ton3k.service; then deb-systemd-invoke restart rpi-ton3k.service; fi
  else
   deb-systemd-helper enable rpi-ton3k.service >/dev/null
   deb-systemd-invoke start rpi-ton3k.service
  fi
 fi
fi
